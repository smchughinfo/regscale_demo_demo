@{
    ViewData["Title"] = "Component Security Analysis";
}

<div class="hero-section">
    <div class="container text-center">
        <h1 class="hero-title">Component Security Analysis</h1>
        <p class="hero-subtitle">AI-powered vulnerability detection for Health Widgets components</p>
    </div>
</div>

<div class="analysis-container">
    <div class="analysis-card">
        <h2 class="card-title">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="card-title-icon">
                <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 16V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 8H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Analyze Components
        </h2>

        <form id="analysisForm">
            <div class="mb-4">
                <label for="promptInput" class="form-label">Security Analysis Query</label>
                <input type="text"
                       class="form-control"
                       id="promptInput"
                       placeholder="e.g., Check for components containing microchips or vulnerabilities in supplier X"
                       required>
                <small class="text-muted">Describe what you want to analyze in our component inventory</small>
            </div>

            <div class="d-grid gap-2 d-md-flex">
                <button type="submit" class="btn-analyze" id="analyzeBtn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" style="display: inline-block;">
                        <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span id="btnText">Analyze</span>
                </button>
            </div>
        </form>

        <div id="resultsSection" class="results-section" style="display: none;">
            <div class="results-label">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Analysis Results
                <span class="results-badge">Complete</span>
            </div>
            <div class="results-output" id="resultsOutput"></div>
        </div>

        <div id="errorSection" class="alert alert-danger alert-custom" style="display: none;" role="alert">
            <strong>Error:</strong> <span id="errorMessage"></span>
        </div>
    </div>

    <div class="analysis-card">
        <h3 class="card-title">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="card-title-icon">
                <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            How It Works
        </h3>
        <div class="row">
            <div class="col-md-4 mb-3">
                <h5 style="color: var(--primary-color); font-weight: 600;">1. Query</h5>
                <p class="text-muted">Enter your security analysis query in natural language</p>
            </div>
            <div class="col-md-4 mb-3">
                <h5 style="color: var(--primary-color); font-weight: 600;">2. AI Analysis</h5>
                <p class="text-muted">Our AI scans your component database and RegScale GRC system</p>
            </div>
            <div class="col-md-4 mb-3">
                <h5 style="color: var(--primary-color); font-weight: 600;">3. Results</h5>
                <p class="text-muted">Receive detailed risk assessments and mitigation recommendations</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('analysisForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const promptInput = document.getElementById('promptInput');
            const analyzeBtn = document.getElementById('analyzeBtn');
            const btnText = document.getElementById('btnText');
            const resultsSection = document.getElementById('resultsSection');
            const resultsOutput = document.getElementById('resultsOutput');
            const errorSection = document.getElementById('errorSection');
            const errorMessage = document.getElementById('errorMessage');

            const prompt = promptInput.value.trim();

            if (!prompt) {
                return;
            }

            // Hide previous results/errors
            resultsSection.style.display = 'none';
            errorSection.style.display = 'none';
            resultsOutput.textContent = '';

            // Show loading state
            analyzeBtn.disabled = true;
            btnText.textContent = 'Analyzing...';
            btnText.innerHTML = '<span class="spinner"></span> Analyzing...';

            try {
                const response = await fetch('https://health-widgets-analyzer.azurewebsites.net/api/analyze', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ prompt: prompt })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                if (data.success) {
                    resultsOutput.textContent = data.result;
                    resultsSection.style.display = 'block';

                    // Scroll to results
                    setTimeout(() => {
                        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }, 100);
                } else {
                    throw new Error(data.error || 'Analysis failed');
                }

            } catch (error) {
                console.error('Analysis error:', error);
                errorMessage.textContent = error.message || 'Failed to connect to analysis service. Please try again.';
                errorSection.style.display = 'block';
            } finally {
                // Reset button state
                analyzeBtn.disabled = false;
                btnText.textContent = 'Analyze';
            }
        });
    </script>
}
